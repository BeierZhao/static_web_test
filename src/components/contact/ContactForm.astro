<form 
  action="https://script.google.com/macros/s/AKfycbx71MCkY6EJR9AuO2iBMQk2wEPKP4QBBdbZutIaIUAXh7jXz7kT7EgUmr110mJOgyV_OQ/exec" 
  method="POST" 
  target="_blank"
  class="bg-white p-8 rounded-xl shadow-lg border border-gray-200"
  x-data="{ submitting: false }"
  @submit="submitting = true; setTimeout(() => submitting = false, 3000)"
>
  <h2 class="text-2xl font-bold mb-6">📝 Quick Inquiry</h2>
  <div class="space-y-4">
    <div>
      <label class="block text-sm font-semibold mb-1">Company Name *</label>
      <input type="text" name="company" required class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-industrial-500 focus:outline-none">
    </div>
    <div>
      <label class="block text-sm font-semibold mb-1">Contact Number *</label>
      <input type="tel" name="phone" required class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-industrial-500 focus:outline-none">
    </div>
    <div>
      <label class="block text-sm font-semibold mb-1">Email</label>
      <input type="email" name="email" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-industrial-500 focus:outline-none">
    </div>
    <div>
      <label class="block text-sm font-semibold mb-1">Project Type *</label>
      <select name="projectType" required class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-industrial-500 focus:outline-none">
        <option value="">Please select</option>
        <option value="Packaging">Packaging</option>
        <option value="Vision">Vision / Inspection</option>
        <option value="Integration">Integration / Full Line</option>
      </select>
    </div>
    <div>
      <label class="block text-sm font-semibold mb-1">Budget Range</label>
      <select name="budget" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-industrial-500 focus:outline-none">
        <option value="">Select</option>
        <option value="<50k">Under $50k</option>
        <option value="50k-150k">$50k - $150k</option>
        <option value="150k-500k">$150k - $500k</option>
        <option value="500k+">$500k+</option>
      </select>
    </div>
    <div>
      <label class="block text-sm font-semibold mb-1">Project Description</label>
      <textarea name="description" rows="4" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-industrial-500 focus:outline-none"></textarea>
    </div>
    <button type="submit" class="btn btn-primary w-full justify-center" :disabled="submitting">
      <span x-show="!submitting">🚀 Submit Inquiry</span>
      <span x-show="submitting" x-cloak>⏳ Submitting...</span>
    </button>
  </div>
</form>