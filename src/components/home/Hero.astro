---
import CTAButton from '../global/CTAButton.astro';
---
<section class="relative min-h-screen flex items-center bg-gradient-to-br from-gray-50 to-industrial-100 overflow-hidden pt-16">
  <div class="absolute inset-0 opacity-30 pointer-events-none">
    <!-- 简单的点阵背景，替代视频占位 -->
    <div class="w-full h-full bg-[radial-gradient(circle_at_30%_50%,#cbd5e1_1px,transparent_1px)] bg-[length:32px_32px]"></div>
  </div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 grid md:grid-cols-2 gap-12 items-center relative z-10 py-20">
    <div class="text-center md:text-left">
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-industrial-900 leading-tight">
        Industrial <span class="text-industrial-600">Packaging</span> & Inspection <span class="text-accent">Automation</span>
      </h1>
      <p class="mt-6 text-lg text-gray-600 max-w-xl">
        Cost-effective industrial automation solutions using global manufacturing, Canadian electrical compliance, and local service support.
      </p>
      <div class="mt-8 flex flex-wrap gap-4 justify-center md:justify-start">
        <CTAButton href="/solutions">Explore Our Solutions</CTAButton>
        <CTAButton href="/contact" variant="outline">Book a Consultation</CTAButton>
      </div>
    </div>
    <div class="hidden md:block relative">
      <div class="bg-white rounded-2xl shadow-2xl p-8 border border-gray-200">
        <div class="grid grid-cols-3 gap-4 mb-6">
          <div class="text-center bg-gray-50 rounded-lg p-3">
            <span class="text-2xl font-bold text-industrial-600">500+</span>
            <span class="block text-xs text-gray-500">Projects</span>
          </div>
          <div class="text-center bg-gray-50 rounded-lg p-3">
            <span class="text-2xl font-bold text-industrial-600">98%</span>
            <span class="block text-xs text-gray-500">Satisfaction</span>
          </div>
          <div class="text-center bg-gray-50 rounded-lg p-3">
            <span class="text-2xl font-bold text-industrial-600">15+</span>
            <span class="block text-xs text-gray-500">Years Exp</span>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="flex items-center gap-2 text-sm font-medium"><span class="w-3 h-3 rounded-full bg-blue-500"></span> Powder Packaging</div>
          <div class="flex items-center gap-2 text-sm font-medium"><span class="w-3 h-3 rounded-full bg-green-500"></span> Vision Inspection</div>
          <div class="flex items-center gap-2 text-sm font-medium"><span class="w-3 h-3 rounded-full bg-orange-500"></span> Laser Coding</div>
          <div class="flex items-center gap-2 text-sm font-medium"><span class="w-3 h-3 rounded-full bg-purple-500"></span> Line Integration</div>
        </div>
      </div>
    </div>
  </div>
</section>