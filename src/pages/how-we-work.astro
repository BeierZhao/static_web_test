---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhaseTimeline from '../components/how-we-work/PhaseTimeline.astro';
---
<BaseLayout title="How We Work">
  <section class="pt-24 pb-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 text-center mb-12">
      <span class="badge">Our Process</span>
      <h1 class="section-title mt-2">How We Deliver</h1>
      <p class="section-subtitle">From design to local support, a transparent 4-phase approach.</p>
    </div>
    <PhaseTimeline />
  </section>
</BaseLayout>